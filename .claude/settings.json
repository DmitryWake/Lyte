{
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(git status*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git fetch*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git stash*)",
      "Bash(git remote*)",
      "Bash(./gradlew *)",
      "Bash(ls*)",
      "Bash(find*)",
      "Bash(tree*)",
      "Bash(pwd)",
      "Bash(wc*)",
      "Bash(file*)",
      "Bash(stat*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(sort*)",
      "Bash(uniq*)",
      "Bash(cut*)",
      "Bash(grep*)",
      "Bash(rg*)",
      "Bash(mkdir*)",
      "Bash(touch*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git rm*)",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__pull_request_read",
      "mcp__github__actions_list",
      "mcp__github__get_check_run",
      "mcp__github__get_job_logs",
      "mcp__github__list_commits",
      "mcp__github__get_commit"
    ],
    "deny": [
      "Edit(*.env)",
      "Write(*.env)",
      "Edit(*.keystore)",
      "Write(*.keystore)",
      "Edit(*.jks)",
      "Write(*.jks)",
      "Edit(**/google-services.json)",
      "Write(**/google-services.json)",
      "Edit(**/credentials*)",
      "Write(**/credentials*)",
      "Edit(**/local.properties)",
      "Write(**/local.properties)",
      "Edit(**/signing*)",
      "Write(**/signing*)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(./gradlew clean build)",
      "Bash(git push*master*)",
      "Edit(**/keystore.properties)",
      "Write(**/keystore.properties)",
      "Edit(**/*.env)",
      "Write(**/*.env)",
      "Edit(**/*.keystore)",
      "Write(**/*.keystore)",
      "Edit(**/*.jks)",
      "Write(**/*.jks)",
      "Edit(version.properties)",
      "Write(version.properties)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-screenshots.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-protected-branch.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
